{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "security:only-security-updates"
  ],
  "enabledManagers": [
    "gomod",
    "tekton",
    "dockerfile"
  ],
  "baseBranchPatterns": [
    "main",
    "/^release-.*/",
    "backplane-2.11",
    "backplane-2.17"
  ],
  "tekton": {
    "includePaths": [
      ".tekton/**"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "enabled": true,
      "matchFileNames": [
        "stolostron/Dockerfile.stolostron"
      ]
    },
    {
      "matchBaseBranches": [
        "main",
        "/^release-.*/",
        "backplane-2.11",
        "backplane-2.17"
      ],
      "matchManagers": [
        "tekton"
      ],
      "enabled": true,
      "addLabels": [
        "ok-to-test"
      ]
    },
    {
      "description": "Disable regular version and digest updates; Renovate security alerts bypass this rule.",
      "matchPackageNames": [
        "*"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "Security fixes",
    "labels": [
      "security",
      "ok-to-test"
    ],
    "prConcurrentLimit": 4
  },
  "rebaseWhen": "behind-base-branch",
  "recreateWhen": "never",
  "addLabels": [
    "ok-to-test"
  ]
}
