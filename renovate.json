{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "security:only-security-updates"
  ],
  "enabledManagers": [
    "gomod",
    "github-actions",
    "tekton",
    "dockerfile"
  ],
  "baseBranchPatterns": [
    "main",
    "/^release-.*/",
    "backplane-2.11",
    "backplane-2.17"
  ],
  "tekton": {
    "includePaths": [
      ".tekton/**"
    ]
  },
  "packageRules": [
    {
      "description": "GitHub Actions updates are maintained on the default branch only.",
      "matchManagers": [
        "github-actions"
      ],
      "matchBaseBranches": [
        "/^release-.*/",
        "/^backplane-2\\.[0-9]+$/"
      ],
      "enabled": false
    },
    {
      "description": "Tekton updates follow main and maintained backplane branches.",
      "matchManagers": [
        "tekton"
      ],
      "matchBaseBranches": [
        "/^release-.*/"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "enabled": true,
      "matchFileNames": [
        "stolostron/Dockerfile.stolostron"
      ],
      "matchBaseBranches": [
        "main",
        "/^backplane-2\\.[0-9]+$/"
      ],
      "pinDigests": true
    },
    {
      "description": "Update the upstream controller image on main, except its Go builder image.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "v2/Dockerfile"
      ],
      "matchBaseBranches": [
        "main"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "v2/Dockerfile"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "enabled": false
    },
    {
      "matchBaseBranches": [
        "main",
        "backplane-2.11",
        "backplane-2.17"
      ],
      "matchManagers": [
        "tekton"
      ],
      "enabled": true,
      "addLabels": [
        "ok-to-test"
      ]
    },
    {
      "description": "Disable regular dependency updates by default; vulnerability-alert updates remain enabled.",
      "matchPackageNames": [
        "*"
      ],
      "enabled": false
    },
    {
      "description": "Keep the Go builder image out of container security updates.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "v2/Dockerfile"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "Security fixes",
    "labels": [
      "dependencies",
      "ok-to-test"
    ],
    "prConcurrentLimit": 4
  },
  "rebaseWhen": "behind-base-branch",
  "recreateWhen": "never",
  "addLabels": [
    "ok-to-test"
  ]
}
